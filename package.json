{
  "name": "secure-review",
  "version": "1.0.0",
  "description": "CLI-based AI security code review tool for GitLab merge requests",
  "main": "bin/secure-review.js",
  "bin": {
    "secure-review": "./bin/secure-review.js"
  },
  "files": [
    "bin/",
    "services/",
    "examples/",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "demo": "node bin/secure-review.js scan --diff-file examples/vulnerable.diff",
    "demo:build": "node scripts/build-demo.js",
    "demo:serve": "node scripts/build-demo.js && node scripts/serve-demo.js",
    "demo:record-gemini": "node scripts/record-gemini-demo.js",
    "start": "node bin/secure-review.js",
    "start:backend": "node backend/server.js"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/helpers/blockNetwork.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomNguyen132006/secure-review.git"
  },
  "keywords": [
    "security",
    "cli",
    "gitlab",
    "gemini",
    "code-review"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/TomNguyen132006/secure-review/issues"
  },
  "homepage": "https://github.com/TomNguyen132006/secure-review#readme",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
